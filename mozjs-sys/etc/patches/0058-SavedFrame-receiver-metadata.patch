+// ---------------------------------------------------------------------------
+// V8-style method-call frame naming. Mirror of CallSiteInfo::GetTypeName,
+// GetMethodName, InferMethodName, StringEndsWithMethodName and
+// AppendMethodCall in v8/src/objects/call-site-info.cc.
+//
+// Receiver-derived names are captured eagerly (in SavedStacks::insertFrames)
+// and stored on the SavedFrame: formatting a saved stack must never inspect
+// live objects. All lookups below are pure shape walks -- no getters are
+// invoked and no user code can run.
+// ---------------------------------------------------------------------------
+
+// v8 String::IsIdentifier: IdentifierStart for the first character,
+// IdentifierPart for all others.
+static bool V8StringIsIdentifier(JSAtom* atom) {
+  size_t length = atom->length();
+  if (length == 0) {
+    return false;
+  }
+  if (!unicode::IsIdentifierStart(atom->latin1OrTwoByteChar(0))) {
+    return false;
+  }
+  for (size_t i = 1; i < length; i++) {
+    if (!unicode::IsIdentifierPart(atom->latin1OrTwoByteChar(i))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Returns true iff subject == method, or subject ends with '.' + method or
+// ' ' + method (v8 StringEndsWithMethodName). Both arguments are atoms, so
+// pointer equality covers the whole-string case.
+static bool V8StringEndsWithMethodName(JSAtom* subject, JSAtom* method) {
+  if (subject == method) {
+    return true;
+  }
+  size_t subjectLength = subject->length();
+  size_t methodLength = method->length();
+  if (subjectLength <= methodLength) {
+    return false;
+  }
+  size_t separatorIndex = subjectLength - methodLength - 1;
+  char32_t separator = subject->latin1OrTwoByteChar(separatorIndex);
+  if (separator != '.' && separator != ' ') {
+    return false;
+  }
+  for (size_t i = 0; i < methodLength; i++) {
+    if (subject->latin1OrTwoByteChar(separatorIndex + 1 + i) !=
+        method->latin1OrTwoByteChar(i)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// The debug name of a function (v8 SharedFunctionInfo::DebugName): the
+// explicit, inferred or guessed atom. Accessors with lazy names have only a
+// partial name, which we must not expose. Returns null when the function has
+// no usable name.
+static JSAtom* V8FunctionDebugName(JSFunction* fun) {
+  if (fun->isAccessorWithLazyName()) {
+    return nullptr;
+  }
+  return fun->rawAtom();
+}
+
+// v8 CallSiteInfo::GetMethodName's candidate: the function name with a
+// leading "get " / "set " stripped, otherwise the substring after the last
+// '.'. Returns false on OOM; *out is null when no candidate exists.
+static bool V8DeriveMethodNameCandidate(JSContext* cx, Handle<JSAtom*> v8Name,
+                                        MutableHandle<JSAtom*> out) {
+  out.set(nullptr);
+  if (!v8Name || v8Name->length() == 0) {
+    return true;
+  }
+
+  size_t length = v8Name->length();
+  size_t start = 0;
+  if (length > 4) {
+    auto prefixIs = [&](const char* prefix) {
+      return v8Name->latin1OrTwoByteChar(0) == prefix[0] &&
+             v8Name->latin1OrTwoByteChar(1) == prefix[1] &&
+             v8Name->latin1OrTwoByteChar(2) == prefix[2] &&
+             v8Name->latin1OrTwoByteChar(3) == ' ';
+    };
+    if (prefixIs("get") || prefixIs("set")) {
+      start = 4;
+    }
+  }
+  if (start == 0) {
+    // No accessor prefix: use the last '.'-segment of the (inferred) name,
+    // e.g. "receiver.method" for a property-assignment inferred name.
+    for (size_t i = length; i-- > 0;) {
+      if (v8Name->latin1OrTwoByteChar(i) == '.') {
+        start = i + 1;
+        break;
+      }
+    }
+    if (start == 0) {
+      out.set(v8Name);
+      return true;
+    }
+  }
+
+  size_t candidateLength = length - start;
+  if (candidateLength == 0) {
+    return true;
+  }
+  // AtomizeString allocates and can GC; the dependent string must stay
+  // rooted across it.
+  RootedString str(cx, NewDependentString(cx, v8Name, start, candidateLength));
+  if (!str) {
+    return false;
+  }
+  out.set(AtomizeString(cx, str));
+  return !!out;
+}
+
+// v8 CallSiteInfo::GetTypeName / Object::ToObject: the receiver used for
+// method naming. Null/undefined receivers were rejected by the caller;
+// primitives are boxed so the standard prototype chain can be walked.
+static bool V8ToObjectReceiver(JSContext* cx, HandleValue receiver,
+                               MutableHandleObject out) {
+  if (receiver.isObject()) {
+    out.set(&receiver.toObject());
+    return true;
+  }
+  out.set(PrimitiveToObject(cx, receiver));
+  return !!out;
+}
+
+// v8 JSReceiver::GetConstructorName: walk the prototype chain and return the
+// name of the first own "constructor" data property that holds a named
+// function; empty names keep the walk going. Falls back to the object's
+// class name ("Object" for plain objects). Stops at non-native objects:
+// walking through a proxy would invoke user traps.
+static JSAtom* V8GetConstructorName(JSContext* cx,
+                                    Handle<JSObject*> receiver) {
+  PropertyKey constructorKey = PropertyKey::NonIntAtom(cx->names().constructor);
+  Rooted<JSObject*> current(cx, receiver);
+  while (current) {
+    if (!current->is<NativeObject>()) {
+      break;
+    }
+    NativeObject& obj = current->as<NativeObject>();
+
+    JSAtom* name = nullptr;
+    for (ShapePropertyIter<NoGC> iter(obj.shape()); !iter.done(); iter++) {
+      PropertyInfoWithKey prop = *iter;
+      if (prop.key() != constructorKey) {
+        continue;
+      }
+      if (prop.isDataProperty()) {
+        const Value& value = obj.getSlot(prop.slot());
+        if (value.isObject() && value.toObject().is<JSFunction>()) {
+          name = V8FunctionDebugName(&value.toObject().as<JSFunction>());
+        }
+      }
+      break;
+    }
+    if (name && name->length() != 0) {
+      return name;
+    }
+
+    current = obj.staticPrototype();
+  }
+
+  // Fallback: the receiver's C++ class name (v8 receiver->class_name()).
+  // JSAtomUtils only instantiates AtomizeChars for Latin1Char/char16_t; class
+  // names are ASCII, so reinterpret them as Latin-1.
+  const char* className = receiver->getClass()->name;
+  return AtomizeChars(cx, reinterpret_cast<const Latin1Char*>(className),
+                      strlen(className));
+}
+
+// v8 CallSiteInfo::GetTypeName.
+static JSAtom* V8GetTypeName(JSContext* cx, Handle<JSObject*> receiver) {
+  if (receiver->is<ProxyObject>()) {
+    return cx->names().Proxy;
+  }
+  if (receiver->is<JSFunction>()) {
+    JSAtom* name = V8FunctionDebugName(&receiver->as<JSFunction>());
+    if (name && name->length() != 0) {
+      return name;
+    }
+  }
+  return V8GetConstructorName(cx, receiver);
+}
+
+// True when |candidate| names an own or inherited property of the receiver
+// whose value is identical to |fun| -- a data value, or a getter/setter of
+// an accessor pair (v8 LookupIterator::PROTOTYPE_CHAIN_SKIP_INTERCEPTOR,
+// reduced to a shape walk that cannot invoke user code).
+static bool V8MethodNameMatches(JSContext* cx, Handle<JSObject*> receiver,
+                                Handle<JSAtom*> candidate, JSFunction* fun) {
+  PropertyKey key = PropertyKey::NonIntAtom(candidate);
+  Rooted<JSObject*> current(cx, receiver);
+  while (current) {
+    if (!current->is<NativeObject>()) {
+      break;
+    }
+    NativeObject& obj = current->as<NativeObject>();
+    for (ShapePropertyIter<NoGC> iter(obj.shape()); !iter.done(); iter++) {
+      PropertyInfoWithKey prop = *iter;
+      if (prop.key() != key) {
+        continue;
+      }
+      if (prop.isDataProperty()) {
+        const Value& value = obj.getSlot(prop.slot());
+        return value.isObject() && &value.toObject() == fun;
+      }
+      if (prop.isAccessorProperty()) {
+        GetterSetter* gs = obj.getGetterSetter(prop);
+        return gs->getter() == fun || gs->setter() == fun;
+      }
+      return false;
+    }
+    current = obj.staticPrototype();
+  }
+  return false;
+}
+
+// v8 InferMethodName, restricted to the receiver's own properties: find the
+// unique enumerable own property whose value (data or accessor) is identical
+// to |fun|. Returns null when nothing, or more than one distinct property,
+// matches. Never walks the prototype chain.
+static JSAtom* V8InferMethodName(Handle<JSObject*> receiver, JSFunction* fun) {
+  if (!receiver->is<NativeObject>()) {
+    return nullptr;
+  }
+  NativeObject& obj = receiver->as<NativeObject>();
+  JSAtom* found = nullptr;
+  for (ShapePropertyIter<NoGC> iter(obj.shape()); !iter.done(); iter++) {
+    PropertyInfoWithKey prop = *iter;
+    if (!prop.enumerable() || !prop.key().isAtom()) {
+      continue;
+    }
+    bool matches = false;
+    if (prop.isDataProperty()) {
+      const Value& value = obj.getSlot(prop.slot());
+      matches = value.isObject() && &value.toObject() == fun;
+    } else if (prop.isAccessorProperty()) {
+      GetterSetter* gs = obj.getGetterSetter(prop);
+      matches = gs->getter() == fun || gs->setter() == fun;
+    }
+    if (!matches) {
+      continue;
+    }
+    JSAtom* key = prop.key().toAtom();
+    if (!found) {
+      found = key;
+    } else if (found != key) {
+      return nullptr;  // ambiguous: multiple distinct properties match
+    }
+  }
+  return found;
+}
+
+// v8 CallSiteInfo::GetMethodName.
+static bool V8GetMethodName(JSContext* cx, Handle<JSObject*> receiver,
+                            Handle<JSFunction*> fun, Handle<JSAtom*> v8Name,
+                            MutableHandle<JSAtom*> out) {
+  Rooted<JSAtom*> candidate(cx);
+  if (!V8DeriveMethodNameCandidate(cx, v8Name, &candidate)) {
+    return false;
+  }
+  if (candidate && V8MethodNameMatches(cx, receiver, candidate, fun)) {
+    out.set(candidate);
+    return true;
+  }
+  out.set(V8InferMethodName(receiver, fun));
+  return true;
+}
+
+// Eagerly capture the V8 method-call naming metadata for a non-constructing
+// function frame: the receiver type name ("Object.Se"'s "Object") and the
+// call site method name (the "render" of "[as render]"). Null/undefined
+// receivers produce no metadata, matching v8. Constructor frames never get
+// receiver metadata; they keep the plain "new X" formatting.
+static bool ComputeV8MethodCallNames(JSContext* cx, Handle<JSFunction*> fun,
+                                     HandleValue receiverValue,
+                                     Handle<JSAtom*> v8Name,
+                                     MutableHandle<JSAtom*> receiverTypeName,
+                                     MutableHandle<JSAtom*> callSiteName) {
+  receiverTypeName.set(nullptr);
+  callSiteName.set(nullptr);
+
+  if (receiverValue.isNullOrUndefined()) {
+    return true;
+  }
+
+  Rooted<JSObject*> receiver(cx);
+  if (!V8ToObjectReceiver(cx, receiverValue, &receiver)) {
+    return false;
+  }
+
+  receiverTypeName.set(V8GetTypeName(cx, receiver));
+  if (!receiverTypeName) {
+    return false;
+  }
+
+  return V8GetMethodName(cx, receiver, fun, v8Name, callSiteName);
+}
