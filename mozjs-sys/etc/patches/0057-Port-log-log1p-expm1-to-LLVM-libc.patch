+  // BigInt(x).pow_n(n) computes x ^ n.
+  // Note 0 ^ 0 == 1.
+  LIBC_INLINE constexpr void pow_n(uint64_t power) {
+    static_assert(!Signed);
+    BigInt result = one();
+    BigInt cur_power = *this;
+    while (power > 0) {
+      if ((power % 2) > 0)
+        result *= cur_power;
+      power >>= 1;
+      cur_power *= cur_power;
+    }
+    *this = result;
+  }
