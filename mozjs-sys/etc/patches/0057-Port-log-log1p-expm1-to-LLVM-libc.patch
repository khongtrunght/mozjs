+  return r0;
+}
+
+[[gnu::always_inline]] LIBC_INLINE long syscall_impl(long number, long arg1) {
+  REGISTER_DECL_1;
+  SYSCALL_INSTR(REGISTER_CONSTRAINT_1);
+  return r0;
+}
+
+[[gnu::always_inline]] LIBC_INLINE long syscall_impl(long number, long arg1,
+                                                     long arg2) {
