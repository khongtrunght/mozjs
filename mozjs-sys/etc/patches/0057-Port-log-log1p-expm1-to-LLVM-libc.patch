+  R7;                                                                          \
+  register long r0 __asm__("r0") = arg1;
+#define REGISTER_DECL_2                                                        \
+  REGISTER_DECL_1                                                              \
+  register long r1 __asm__("r1") = arg2;
+#define REGISTER_DECL_3                                                        \
+  REGISTER_DECL_2                                                              \
+  register long r2 __asm__("r2") = arg3;
+#define REGISTER_DECL_4                                                        \
+  REGISTER_DECL_3                                                              \
