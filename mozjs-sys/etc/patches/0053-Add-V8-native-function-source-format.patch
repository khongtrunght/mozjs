diff --git a/js/public/Stack.h b/js/public/Stack.h
index 5442b14..81f3246 100644
--- a/js/public/Stack.h
+++ b/js/public/Stack.h
@@ -61,6 +61,23 @@ extern JS_PUBLIC_API StackFormat GetStackFormat(JSContext* cx);
 
 namespace JS {
 
+enum class NativeFunctionSourceFormat { SpiderMonkey, V8 };
+
+/**
+ * Select the Function.prototype.toString representation for functions without
+ * source text. SpiderMonkey (the default) uses a multi-line native-code body;
+ * V8 uses a single-line body and preserves native accessor name prefixes.
+ * Real source text and the non-standard toSource extension are unchanged.
+ * Like SetStackFormat, this setting belongs to the root runtime and is
+ * inherited by child runtimes. The setter must be called on the root runtime's
+ * context.
+ */
+extern JS_PUBLIC_API void SetNativeFunctionSourceFormat(
+    JSContext* cx, NativeFunctionSourceFormat format);
+
+extern JS_PUBLIC_API NativeFunctionSourceFormat
+GetNativeFunctionSourceFormat(JSContext* cx);
+
 /**
  * Capture all frames.
  */
diff --git a/js/src/jsapi-tests/testFunctionProperties.cpp b/js/src/jsapi-tests/testFunctionProperties.cpp
index 37ef689..104fbba 100644
--- a/js/src/jsapi-tests/testFunctionProperties.cpp
+++ b/js/src/jsapi-tests/testFunctionProperties.cpp
@@ -3,6 +3,7 @@
  * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
 
 #include "js/PropertyAndElement.h"  // JS_GetProperty
+#include "js/Stack.h"
 #include "jsapi-tests/tests.h"
 
 BEGIN_TEST(testFunctionProperties) {
@@ -21,3 +22,49 @@ BEGIN_TEST(testFunctionProperties) {
   return true;
 }
 END_TEST(testFunctionProperties)
+
+BEGIN_TEST(testNativeFunctionSourceFormat) {
+  JS::RootedValue result(cx);
+  EVAL(
+      "eval.toString() === 'function eval() {\\n    [native code]\\n}' && "
+      "(function(){}).bind(null).toString() === "
+      "'function() {\\n    [native code]\\n}' && "
+      "Object.getOwnPropertyDescriptor(Map.prototype, 'size').get.toString() "
+      "=== 'function size() {\\n    [native code]\\n}'",
+      &result);
+  CHECK(result.toBoolean());
+
+  EXEC(
+      "var originalNativeSource = eval.toSource();"
+      "var originalBoundSource = (function(){}).bind(null).toSource();");
+  JS::SetNativeFunctionSourceFormat(cx, JS::NativeFunctionSourceFormat::V8);
+  EVAL(
+      "eval.toString() === 'function eval() { [native code] }' && "
+      "(function(){}).bind(null).toString() === "
+      "'function () { [native code] }' && "
+      "Object.getOwnPropertyDescriptor(Map.prototype, 'size').get.toString() "
+      "=== 'function get size() { [native code] }' && "
+      "eval.toSource() === originalNativeSource && "
+      "(function(){}).bind(null).toSource() === originalBoundSource && "
+      "(function real(a) { return a; }).toString() === "
+      "'function real(a) { return a; }'",
+      &result);
+  CHECK(result.toBoolean());
+
+  JS::SetNativeFunctionSourceFormat(
+      cx, JS::NativeFunctionSourceFormat::SpiderMonkey);
+  EVAL("eval.toString() === 'function eval() {\\n    [native code]\\n}'",
+       &result);
+  CHECK(result.toBoolean());
+  return true;
+}
+
+JSObject* createGlobal(JSPrincipals* principals = nullptr) override {
+  JS::RealmOptions options;
+  options.creationOptions().setToSourceEnabled(true);
+  global = JS_NewGlobalObject(cx, getGlobalClass(), principals,
+                              JS::FireOnNewGlobalHook, options);
+  return global;
+}
+
+END_TEST(testNativeFunctionSourceFormat)
